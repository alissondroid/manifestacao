# Copie para .env (ignorado pelo git).

# URL pública do site, usada para validar a origem do WebSocket. Obrigatória em produção.
# PUBLIC_URL=https://seu-dominio.com

# PORT=8787
# DB_PATH=data/avenida.db
# AOI=70

# Produção: atrás de proxy/CDN seu (nginx, Cloudflare), ligue para o IP real chegar por X-Forwarded-For.
# TRUST_PROXY=1
# Origens extras aceitas no WebSocket (além de PUBLIC_URL), separadas por vírgula.
# ALLOWED_ORIGINS=https://www.seu-dominio.com
# MAX_SPECTATORS=100
# API de administração (denúncias e banimentos). Só existe se definido, com 16+ caracteres. Gere com: openssl rand -hex 24
# ADMIN_TOKEN=

# Login com Google (opcional). Crie um "ID do cliente OAuth" do tipo Aplicativo da Web em console.cloud.google.com
# e cadastre o domínio do site em "Origens JavaScript autorizadas". Sem isto o botão não aparece.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
