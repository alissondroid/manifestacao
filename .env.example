# Copie para .env (ignorado pelo git). Use SOMENTE chaves de teste.

# Stripe Checkout (cartão e Pix de teste). Sem isto, o checkout é simulado localmente.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_…), do Dashboard ou do `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# URL pública do site, usada nos retornos do pagamento. Obrigatória em produção.
# PUBLIC_URL=https://seu-dominio.com

# PORT=8787
# DB_PATH=data/avenida.db
# AOI=70

# Produção: atrás de proxy/CDN seu (nginx, Cloudflare), ligue para o IP real chegar por X-Forwarded-For.
# TRUST_PROXY=1
# Origens extras aceitas no WebSocket (além de PUBLIC_URL), separadas por vírgula.
# ALLOWED_ORIGINS=https://www.seu-dominio.com
# MAX_SPECTATORS=100
# Só para testes em produção sem Stripe: libera o checkout simulado (entrega itens sem cobrar!).
# ALLOW_SIMULATED=1
