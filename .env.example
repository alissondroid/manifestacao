# Copie para .env (ignorado pelo git). Use SOMENTE chaves de teste.

# Pix pela AbacatePay (vende SÓ por Pix e tem prioridade sobre o Stripe). Chave em abacatepay.com > Integrações.
# Chave "abc_dev_..." = modo de teste (nada é cobrado, aparece o botão de simular pagamento); "abc_prod_..." = cobra de verdade.
ABACATEPAY_API_KEY=
# Opcional: segredo do webhook. Cadastre no painel a URL https://SEU-DOMINIO/api/abacatepay/webhook?webhookSecret=ESTE_SEGREDO
# (gere com: openssl rand -hex 24). Sem ele o pagamento ainda é confirmado pela página do Pix, só que com o jogador presente.
ABACATEPAY_WEBHOOK_SECRET=

# Stripe Checkout (cartão e Pix de teste). Ignorado quando ABACATEPAY_API_KEY está preenchida. Sem isto, o checkout é simulado localmente.
STRIPE_SECRET_KEY=
# Segredo do endpoint de webhook (whsec_…), do Dashboard ou do `stripe listen`.
STRIPE_WEBHOOK_SECRET=

# URL pública do site, usada nos retornos do pagamento. Obrigatória em produção.
# PUBLIC_URL=https://seu-dominio.com

# PORT=8787
# DB_PATH=data/avenida.db
# AOI=70

# Produção: atrás de proxy/CDN seu (nginx, Cloudflare), ligue para o IP real chegar por X-Forwarded-For.
# TRUST_PROXY=1
# Origens extras aceitas no WebSocket (além de PUBLIC_URL), separadas por vírgula.
# ALLOWED_ORIGINS=https://www.seu-dominio.com
# MAX_SPECTATORS=100
# API de administração (denúncias e banimentos). Só existe se definido, com 16+ caracteres. Gere com: openssl rand -hex 24
# ADMIN_TOKEN=
# Só para testes em produção sem Stripe: libera o checkout simulado (entrega itens sem cobrar!).
# ALLOW_SIMULATED=1

# Login com Google (opcional). Crie um "ID do cliente OAuth" do tipo Aplicativo da Web em console.cloud.google.com
# e cadastre o domínio do site em "Origens JavaScript autorizadas". Sem isto o botão não aparece.
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
